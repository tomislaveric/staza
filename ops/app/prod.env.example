# Copy to /opt/staza/prod/.env and replace all placeholders with unique values.
STAZA_IMAGE=ghcr.io/tomislaveric/staza
STAZA_IMAGE_TAG=1.0.0

POSTGRES_DB=staza_prod
POSTGRES_USER=staza_prod
POSTGRES_PASSWORD=replace-with-a-different-unique-random-password
# URL-encode any reserved characters in the password used in DATABASE_URL.
DATABASE_URL=postgres://staza_prod:URL_ENCODED_PASSWORD@postgres:5432/staza_prod

WEBAUTHN_RP_ID=play.staza.world
WEBAUTHN_RP_NAME=Staza
WEBAUTHN_ORIGIN=https://play.staza.world

# SMTP delivery for authentication codes and security notifications.
# Point these at your existing mail server (not a self-hosted one).
# Use port 587 with SMTP_SECURE=false (STARTTLS) or port 465 with SMTP_SECURE=true.
SMTP_HOST=smtp.staza.world
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=auth@staza.world
# Provide the password via exactly one of the two variables below.
# SMTP_PASSWORD holds the raw password, but Node and Docker Compose parsing mangle
# quotes, '#', and '$'. If your password contains any of those, prefer the base64
# form instead: printf '%s' 'your#passw"rd' | base64
# SMTP_PASSWORD=replace-with-the-mailbox-password
SMTP_PASSWORD_BASE64=replace-with-base64-of-the-mailbox-password
MAIL_FROM=auth@staza.world

# Optional Strava import; disabled unless the first four values are set.
# STRAVA_CLIENT_ID=replace-with-strava-client-id
# STRAVA_CLIENT_SECRET=replace-with-strava-client-secret
# STRAVA_REDIRECT_URI=https://play.staza.world/api/integrations/strava/callback
# Generate once per environment and keep stable: openssl rand -base64 32
# STRAVA_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# STRAVA_RECENT_ACTIVITY_LIMIT=3

# Copy to .env for the local PostgreSQL service in docker-compose.yml.
DATABASE_URL=postgresql://post_ride_ar:post_ride_ar@localhost:5432/post_ride_ar

# Staza World basemap. Any MapLibre style URL works; the tile provider is not
# coupled to World logic. Defaults to the keyless OpenFreeMap Liberty style.
# BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# BASEMAP_ATTRIBUTION=
# Extra origins the browser must reach when a style loads tiles, sprites, or
# glyphs from hosts other than the style URL origin.
# BASEMAP_EXTRA_ORIGINS=
# Maximum collectibles and quests returned for one map viewport.
# WORLD_VIEWPORT_LIMIT=300

# quäldich pass catalog importer (npm run import:quaeldich). Official ODbL 1.0
# Pässelexikon GeoJSON source and the default collection radius for imported
# mountain passes.
# QUAELDICH_GEOJSON_URL=https://www.quaeldich.de/common/js/paesse_geojson.php?license=odbl
# MOUNTAIN_PASS_DEFAULT_RADIUS_M=100
